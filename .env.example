# Single-session mode only: keep this value private and use the MeshTech~ prefix.
# Leave blank when running `npm run start:multi-user`; each account then gets its own auth directory.
SESSION_ID=

# Multi-session server settings. Unlimited is the default; host resources and WhatsApp stability remain the practical limits.
MAX_BOT_INSTANCES=unlimited
MULTI_USER_AUTH_DIR=/data/meshtech/auth_sessions
MULTI_USER_PORT=5000

# Bot runtime
MODE=public
TIME_ZONE=Africa/Nairobi

# Durable storage: point these at a persistent Railway volume or VPS directory.
# AUTH_DIR stores the Baileys SQLite auth state.
AUTH_DIR=/data/meshtech/auth
# SESSION_DB_FILE is optional; it defaults to AUTH_DIR/session.db.
SESSION_DB_FILE=/data/meshtech/auth/session.db
# DATA_FILE is the bot's main local SQLite database file.
DATA_FILE=/data/meshtech/data/database.db
# MESSAGE_STORE_FILE is optional; it defaults beside DATA_FILE or under AUTH_DIR.
MESSAGE_STORE_FILE=/data/meshtech/data/store.db

# Optional external database. If set, the bot uses this instead of DATA_FILE for Sequelize.
# DATABASE_URL=

# Optional authenticated Pollinations AI fallback.
# Create a key at https://enter.pollinations.ai and set it in Railway/Render/VPS secrets.
POLLINATIONS_API_KEY=
# Optional overrides for testing or selecting another compatible model.
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
POLLINATIONS_MODEL=openai

# Optional deployment values used by the existing bot configuration.
AUTO_READ_STATUS=false
AUTO_LIKE_STATUS=false
